# --- Bot ---
PREFIXES=!,.,/
OWNER_JID=
BOT_NAME=WA Bot Full
TZ=Asia/Makassar
PAIRING_NUMBER=
ARENA_API=http://localhost:3001/api/wa/arena
PORT=3000

# --- Anti-ban ---
SEND_MIN_DELAY=3000
SEND_MAX_DELAY=8000
MAX_PER_MINUTE=25

# --- DB (opsional, auto-fallback ke JSON) ---
# DATABASE_URL=postgres://wa:wa@localhost:5432/wabot
# REDIS_URL=redis://localhost:6379

# --- Panel Laravel (localhost only untuk /wa/*) ---
# PANEL_PORT=3000
# PANEL_API_KEY=isi-random-48-hex
# IP/host yang bisa dibuka HP satu WiFi (cek: ip -4 route get 1.1.1.1)
# PUBLIC_BASE=http://192.168.1.5
# URL publik via tunnel (diisi otomatis oleh ~/projects/tunnels.sh)
# ARENA_PUBLIC_URL=https://xxx.trycloudflare.com
# BOT_PUBLIC_URL=https://yyy.trycloudflare.com

# --- Arena RPG PvP (isi sama dengan PANEL_API_KEY agar skor masuk !rank) ---
# ARENA_WA_KEY=isi-random-48-hex
# ARENA_WA_API=http://127.0.0.1:3000/api/wa/score

# --- AI gratis (isi salah satu, boleh kosong = mode lokal mock) ---
# GEMINI_API_KEY=
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# NINE_ROUTER_URL=http://localhost:9090/v1/chat/completions
# NINE_ROUTER_KEY=
# HERMES_WEBHOOK=http://localhost:8080/chat
